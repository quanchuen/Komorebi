# Optional. Copy to weather.env (gitignored) to use a paid weather provider
# or enable natural-language route intent in the compose `api` service:
#   cp weather.env.example weather.env
#
# Without this file the API defaults to open-meteo (free, no key) and
# POST /routing/intent returns 503.
WEATHER_PROVIDER=open-meteo
#WEATHER_API_KEY=
#ANTHROPIC_API_KEY=
