# Copy to db.env (gitignored) before using docker-compose:
#   cp db.env.example db.env
#
# Read by the api, martin, and plateau_shadow services via `env_file`.
# `host.docker.internal` reaches a Postgres running on the host; use the
# service name instead if you move Postgres into the compose file.
DATABASE_URL=postgres://osm_dev:osm_dev@host.docker.internal:5432/cyclist_map_dev?sslmode=disable

# Required by the api service. Generate your own for anything deployed:
#   openssl rand -base64 32
JWT_SECRET=cyclist-map-dev-secret-do-not-use-in-production
